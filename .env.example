# Copie para .env e preencha.

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
DJANGO_CSRF_TRUSTED_ORIGINS=

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENÇÃO: se perder esta chave, os tokens salvos no banco não podem ser lidos.
CHAVE_CRIPTOGRAFIA=

# Endereço pelo qual a Evolution e o Google acessam este sistema.
# Com a Evolution no Docker e o Django na sua máquina: http://host.docker.internal:8000
URL_PUBLICA=http://host.docker.internal:8000

# Endereço que o navegador usa para abrir o painel (retorno do login do Google).
# Em produção: https://seu.dominio.com.br
URL_SITE=http://localhost:8000
WEBHOOK_TOKEN=troque-por-um-token-aleatorio

# PostgreSQL (opcional; sem isso usa SQLite)
# DATABASE_NAME=clinica
# DATABASE_USER=postgres
# DATABASE_PASSWORD=
# DATABASE_HOST=localhost
# DATABASE_PORT=5432

# Fila de tarefas (Celery + Redis). Opcional: sem isso (ou sem worker rodando) o assistente usa
# threads e os lembretes saem pelo botão do painel / comando enviar_lembretes.
# Em produção, com Docker: redis://redis:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# Evolution API (usado pelo docker-compose)
EVOLUTION_API_KEY=troque-por-uma-chave-aleatoria
# Use apenas letras e números (vai dentro de uma URL de conexão).
EVOLUTION_DB_PASSWORD=troque-por-uma-senha-aleatoria
